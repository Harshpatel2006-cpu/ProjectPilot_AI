# ═══════════════════════════════════════════════════════
# ProjectPilot AI — Environment Configuration
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your keys.
# All keys are OPTIONAL — the app works fully offline
# with its built-in intelligent mock engine.
#
# ── Google Gemini (Recommended for Hackathon) ──────────
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI (Alternative) ───────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Express Backend Port ───────────────────────────────
PORT=3001

# ── Vite Frontend (optional overrides) ────────────────
# If you want the frontend to call the backend:
VITE_BACKEND_URL=http://localhost:3001
# If you want the frontend to call Gemini/OpenAI directly (no backend):
# VITE_AI_API_KEY=your_key_here
